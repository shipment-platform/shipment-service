{
  "family": "shipment-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::581979856637:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::581979856637:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "shipment-service",
      "image": "IMAGE_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "postgres"
        },
        {
          "name": "SPRING_DATA_REDIS_PORT",
          "value": "6379"
        }
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_URL",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_DATASOURCE_URL"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_DATASOURCE_PASSWORD"
        },
        {
          "name": "SPRING_DATA_REDIS_HOST",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_DATA_REDIS_HOST"
        },
        {
          "name": "SPRING_DATA_REDIS_USERNAME",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_DATA_REDIS_USERNAME"
        },
        {
          "name": "SPRING_DATA_REDIS_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_DATA_REDIS_PASSWORD"
        },
        {
          "name": "SPRING_KAFKA_BOOTSTRAP_SERVERS",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_KAFKA_BOOTSTRAP_SERVERS"
        },
        {
          "name": "SPRING_KAFKA_API_KEY",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_KAFKA_API_KEY"
        },
        {
          "name": "SPRING_KAFKA_API_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_KAFKA_API_SECRET"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shipment-service",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "shipment-service",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}